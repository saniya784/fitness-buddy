# Copy this file to .env.local and set values for your own deployments.
# Never commit populated environment files or production credentials.

# Next.js
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_URL=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
NEXT_PUBLIC_SITE_URL=

# Optional browser voice and support settings
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
NEXT_PUBLIC_VAPI_ASSISTANT_ID=
NEXT_PUBLIC_SUPPORT_EMAIL=

# Optional Sentry settings
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Convex deployment environment
CLERK_JWT_ISSUER_DOMAIN=
CLERK_WEBHOOK_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=
VAPI_WEBHOOK_SECRET=
RESEND_API_KEY=
REMINDER_FROM_EMAIL=
APP_URL=

# Local Convex CLI and browser-test settings
CONVEX_DEPLOYMENT=
PLAYWRIGHT_PORT=

# NODE_ENV, NEXT_RUNTIME, and CI are provided by the hosting/test platforms.
